# --- local configuration -----------------------------------------------------
# pxe.env describes YOUR network (addresses, interface, hostname). It is created
# from pxe.env.example and must never be committed. Only the example is tracked.
pxe.env
*.env
!pxe.env.example

# answer.toml holds the target's ROOT PASSWORD (hashed or not) and its
# addressing. Only the example is tracked. Never commit a real one.
answer.toml
answer*.toml
!answer.toml.example

# --- payloads ----------------------------------------------------------------
# Multi-GB images. These are rebuilt from upstream by payloads/*.sh, never
# stored here. Listed defensively in case anyone builds inside the checkout.
*.iso
*.img
*.sfs
*.squashfs
initrd
initrd.*
linux26
vmlinuz*
*.efi
*.kpxe
*.lkrn
# Leading slash matters: an unanchored `srv/` would also match templates/srv/,
# silently dropping the tracked config templates.
/srv/
/work/
/work-*/
/iso/
/tftp/
/http/

# --- secrets (defensive: nothing here should ever hold these) ----------------
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ecdsa*
id_ed25519*
*_rsa
*_ecdsa
*_ed25519
authorized_keys
known_hosts
.netrc
credentials
credentials/
secrets/
*.secret

# --- logs / scratch ----------------------------------------------------------
*.log
*.bak
*.orig
*.rej
*.tmp
*.swp
*~
.staging/
_staging/

# --- OS / editor -------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
.vscode/

# Per-node output from new-node.sh: cleartext root passwords and the
# answer files built from them. Never commit either.
nodes/

# Declarative node definitions naming your real network.
nodes.yaml
nodes.yml
nodes.json
