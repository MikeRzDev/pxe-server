# Defaults for new-node.sh. Copy to nodes.env (gitignored) and edit.
#
#   cp nodes.env.example nodes.env && $EDITOR nodes.env
#
# Addresses here are RFC 5737 documentation examples - replace them.

# Static range new nodes are allocated from. new-node.sh picks the first
# address that neither answers a ping nor is already claimed in secrets/.
# Keep this OUTSIDE your router's DHCP pool.
NODE_IP_START=203.0.113.20
NODE_IP_END=203.0.113.40
NODE_CIDR_BITS=24

NODE_GATEWAY=203.0.113.1
NODE_DNS=203.0.113.1

# <name>.<domain> becomes the node's FQDN.
NODE_DOMAIN=lan

NODE_TIMEZONE=UTC
NODE_COUNTRY=us
NODE_KEYBOARD=en-us
NODE_MAILTO=you@example.com

# Disk selection. "auto" emits filter.DEVNAME = "*", which is resolved on the
# target - so a single-disk PC installs correctly whether its disk is called
# sda or nvme0n1, with no need to inspect it first.
# On a machine with MORE THAN ONE disk "*" matches all of them and the choice
# is undefined; name that disk explicitly instead (NODE_DISKS=sda or --disk).
NODE_DISKS=auto
NODE_FS=ext4

# Optional: public key installed for root, so you can SSH in immediately.
#NODE_SSH_KEY=ssh-ed25519 AAAA... you@host
