# Copy to pxe.env next to install.sh, or pass with --config, to override the
# values install.sh would otherwise detect from the host.
#
#   cp pxe.env.example pxe.env && $EDITOR pxe.env
#
# Everything here is optional. install.sh auto-detects all of it from the
# default route, and dies with a clear message if it cannot.
#
# pxe.env itself is gitignored - it describes your network, not the project.

# Interface the PXE clients are on. Detected from the default route.
#IFACE=eth0

# The address clients will fetch the kernel and initrd from. This is baked into
# dnsmasq's dhcp-boot and into the boot-*.ipxe scripts, so it must be STABLE -
# give the host a static address or a static lease before installing, or a DHCP
# change will silently break stage 2.
#SERVER_IP=203.0.113.10

# The LAN, used to scope the TFTP and HTTP firewall rules.
# NOTE: the DHCP rules (67, 4011) are deliberately NOT scoped to this - a PXE
# client has no address yet, so its DHCPDISCOVER is 0.0.0.0 -> 255.255.255.255
# and would never match a subnet-scoped rule. See pxectl's PORTS table.
#LAN_CIDR=203.0.113.0/24

# Network address for dnsmasq's proxy-DHCP range. Defaults to the network part
# of LAN_CIDR, which is almost always what you want.
#LAN_NET=203.0.113.0

# Cosmetic only - shown in the iPXE boot menus.
#SERVER_NAME=pxe

# Which user owns the payload tree and gets the ~/scripts wrappers.
# Defaults to the user running sudo.
#PXE_USER=admin

# Where payloads live. Needs ~10 GB free for a couple of images.
#PXE_ROOT=/srv/pxe
