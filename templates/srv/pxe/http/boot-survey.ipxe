#!ipxe
# pxe-description: HEADLESS DISK SURVEY (SystemRescue 13.01) - reads only, then powers off
# pxe-payload-dir: sysresccd

# Boots the SystemRescue tree already unpacked for the `rescue` payload, but
# with ar_source= pointing at an autorun script on this server. The machine
# netboots, inventories its disks, POSTs the report back and powers itself off.
# No keyboard, no monitor, no disk written.
#
# This exists because the Proxmox installer's own POST to the answer server
# describes the machine's DMI and NICs and says NOTHING about its disks - so on
# a multi-disk box there is no way to learn what is in there without going and
# looking. This is the looking, done remotely.
#
# ar_nowait is SystemRescue's default in 13.x, but is stated anyway: if it ever
# flips back, a headless machine would sit forever at a "press a key" prompt
# that nobody is there to answer.
#
# copytoram, so the root filesystem is in RAM before the survey runs and the
# poweroff at the end cannot hang on a network mount. Needs ~2 GB.

set base-url http://@@SERVER_IP@@
set karch archisobasedir=sysresccd ip=dhcp archiso_http_srv=${base-url}/ checksum
set arargs ar_source=${base-url}/autorun/survey ar_nowait=1 ar_attempts=3

:start
menu Disk survey  --  read-only inventory, then power off (@@SERVER_NAME@@)
item --gap --                 This machine will NOT be modified
item survey                   Survey disks, report to @@SERVER_IP@@, power off   [default]
item survey-nomodeset         Same, nomodeset  (no/odd GPU)
item --gap --                 Other
item plain                    Plain SystemRescue shell  (no autorun)
item shell                    iPXE shell
choose --timeout 10000 --default survey selected || goto survey
goto ${selected}

:survey
set kopts ${karch} copytoram ${arargs}
goto load

:survey-nomodeset
set kopts ${karch} copytoram nomodeset ${arargs}
goto load

:plain
set kopts ${karch} copytoram ar_disable=1
goto load

:load
echo
echo Loading SystemRescue 13.01 - DISK SURVEY (read-only)
echo   cmdline : ${kopts}
echo   client  : ${net0/mac}  ${ip}
echo
echo No disk is written. The report goes to @@SERVER_IP@@ and the machine
echo powers itself off when it is done.
echo
kernel ${base-url}/sysresccd/boot/x86_64/vmlinuz ${kopts} || goto failed
initrd ${base-url}/sysresccd/boot/intel_ucode.img                || goto failed
initrd ${base-url}/sysresccd/boot/amd_ucode.img                  || goto failed
initrd ${base-url}/sysresccd/boot/x86_64/sysresccd.img           || goto failed
boot || goto failed

:failed
echo
echo BOOT FAILED - dropping to an iPXE shell.
echo Try:  imgfetch ${base-url}/sysresccd/boot/x86_64/vmlinuz
echo

:shell
shell
