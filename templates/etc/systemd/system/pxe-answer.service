[Unit]
Description=PXE answer server - per-machine Proxmox answer files over HTTP
Documentation=https://github.com/MikeRzDev/pxe-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/pxe-answer-server
Restart=on-failure
RestartSec=2
# Read-only view of everything except the answer directory it serves. The one
# exception is the survey directory: POST /survey writes disk inventories there
# so a multi-disk machine can be inspected before it is installed.
ProtectSystem=strict
ReadWritePaths=@@SURVEY_DIR@@
# The service is ProtectSystem=strict, so clearing a stale release file
# needs this named explicitly or the unlink fails with EROFS.
ReadWritePaths=@@GO_DIR@@
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# Answers hold a root password hash, so do not run this as root.
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
