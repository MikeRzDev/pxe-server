[Unit]
Description=PXE node credential store - verify, self-heal, snapshot
Documentation=file://@@PXE_HOME@@/pxe-server/new_machine_onboarding/README.md
# Nothing to guard before the first node is enrolled.
ConditionPathIsDirectory=@@PXE_HOME@@/pxe-server/new_machine_onboarding/secrets

[Service]
Type=oneshot
# Runs as root: chattr +i on the live secrets and on every snapshot is the
# part that makes an accidental rm impossible, and only root can set it.
Environment=ONBOARD_DIR=@@PXE_HOME@@/pxe-server/new_machine_onboarding
Environment=ANSWER_DIR=@@ANSWER_DIR@@
Environment=BACKUP_ROOT=/var/backups/pxe-secrets
ExecStart=@@PXE_HOME@@/scripts/secrets-guard.sh autoheal
Nice=10
IOSchedulingClass=idle
