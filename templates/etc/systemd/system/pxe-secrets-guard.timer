[Unit]
Description=Hourly integrity check + snapshot of the PXE credential store
Documentation=file://@@PXE_HOME@@/pxe-server/new_machine_onboarding/README.md

[Timer]
# The one thing on this host that does run unattended. It touches no network
# service and arms no payload - it only reads secrets/ and writes snapshots
# under /var/backups. A node's root password exists in exactly one place
# until this has run.
OnBootSec=3min
OnUnitActiveSec=1h
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
